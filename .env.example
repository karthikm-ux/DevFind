# Weaviate Cloud Configuration
# Obtain your cluster URL and API key from https://console.weaviate.cloud
WEAVIATE_URL=your-cluster-subdomain.c0.region.aws.weaviate.cloud
WEAVIATE_API_KEY=your-weaviate-api-key

# GitHub Integration (optional - for importing issues from a GitHub repo)
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN
GITHUB_REPO_OWNER=your-org-or-username
GITHUB_REPO_NAME=your-repository-name

# LLM / RAG Assistant Configuration (optional)
# Supported providers: ollama (recommended local free), openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
# OPENAI_MODEL=gpt-4o-mini

# Application Settings
DEVFIND_ENV=development
LOG_LEVEL=INFO
